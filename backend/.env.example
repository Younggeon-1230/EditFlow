APP_NAME=EditFlow API
APP_VERSION=0.1.0
ENVIRONMENT=development

# Database
# Production requires a complete, non-loopback postgresql+psycopg URL supplied
# by the hosting secret store. Never reuse the local example password.
DATABASE_URL=sqlite:///./editflow.db
# PostgreSQL local development example (match compose.yaml placeholders):
# DATABASE_URL=postgresql+psycopg://editflow:editflow-local-only@127.0.0.1:5432/editflow_dev
# PostgreSQL integration tests only; the database name must end in _test:
# TEST_DATABASE_URL=postgresql+psycopg://editflow:editflow-local-only@127.0.0.1:5432/editflow_test
# EDITFLOW_POSTGRESQL_QA=1
# Origins and hosts
# Production requires exact HTTPS origins and matching public host names.
# Wildcards, URL paths, and implicit localhost fallbacks are rejected.
FRONTEND_ORIGINS=http://127.0.0.1:5173
TRUSTED_HOSTS=127.0.0.1,localhost,testserver

# Production PostgreSQL pool (ignored by SQLite and non-production engines)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Auth and CSRF
AUTH_SESSION_COOKIE_NAME=editflow_session
AUTH_CSRF_COOKIE_NAME=editflow_csrf
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
# Production requires AUTH_COOKIE_SECURE=true and SameSite=Lax.
AUTH_COOKIE_SAMESITE=lax
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=128
AUTH_LOGIN_RATE_LIMIT_REQUESTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_SIGNUP_RATE_LIMIT_REQUESTS=3
AUTH_SIGNUP_RATE_LIMIT_WINDOW_SECONDS=600

# External provider features are optional and fail at request time.
YOUTUBE_API_KEY=
PEXELS_API_KEY=
EXTERNAL_API_TIMEOUT_SECONDS=10
EXTERNAL_API_CACHE_TTL_SECONDS=300
EXTERNAL_API_CACHE_MAX_ENTRIES=256
YOUTUBE_DEFAULT_MAX_RESULTS=12
YOUTUBE_MAX_RESULTS_LIMIT=25
PEXELS_DEFAULT_PER_PAGE=12
PEXELS_MAX_PER_PAGE=40

# AI content recommendations (backend only; live calls are opt-in)
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
LLM_API_KEY=
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RECOMMENDATIONS=8
LLM_DEFAULT_RECOMMENDATIONS=5
LLM_MAX_OUTPUT_TOKENS=3000
LLM_PROMPT_VERSION=v2
# In production, both LLM_API_KEY and this 32-byte-or-longer random secret are
# required when LLM_LIVE_CALLS_ENABLED=true.
LLM_RECOMMENDATION_SIGNING_SECRET=
LLM_RECOMMENDATION_TOKEN_TTL_SECONDS=900
LLM_RATE_LIMIT_REQUESTS=5
LLM_RATE_LIMIT_WINDOW_SECONDS=60
LLM_LIVE_CALLS_ENABLED=false
