APP_NAME=EditFlow API
APP_VERSION=0.1.0
ENVIRONMENT=development

DATABASE_URL=sqlite:///./editflow.db
FRONTEND_ORIGIN=http://localhost:5173

YOUTUBE_API_KEY=
PEXELS_API_KEY=
EXTERNAL_API_TIMEOUT_SECONDS=10
EXTERNAL_API_CACHE_TTL_SECONDS=300
EXTERNAL_API_CACHE_MAX_ENTRIES=256
YOUTUBE_DEFAULT_MAX_RESULTS=12
YOUTUBE_MAX_RESULTS_LIMIT=25
PEXELS_DEFAULT_PER_PAGE=12
PEXELS_MAX_PER_PAGE=40

# AI content recommendations (backend only; live calls are opt-in)
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
LLM_API_KEY=
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RECOMMENDATIONS=8
LLM_DEFAULT_RECOMMENDATIONS=5
LLM_MAX_OUTPUT_TOKENS=3000
LLM_PROMPT_VERSION=v2
# Use at least 32 random bytes in deployed environments.
LLM_RECOMMENDATION_SIGNING_SECRET=
LLM_RECOMMENDATION_TOKEN_TTL_SECONDS=900
LLM_RATE_LIMIT_REQUESTS=5
LLM_RATE_LIMIT_WINDOW_SECONDS=60
LLM_LIVE_CALLS_ENABLED=false
